ADMIN_PASSWORD=your-admin-password

# SCRAPE_INTERVAL_MS=300000

DATABASE_PATH=./data/examensradar.db

APP_URL=https://examensradar.de

# SMTP_USER is the Scaleway Project ID; SMTP_PASS is the secret key of an
# IAM API key that carries TransactionalEmail permissions.
# Port 465/2465 = implicit TLS, 587/2587 = STARTTLS.
SMTP_HOST=smtp.tem.scaleway.com
SMTP_PORT=465
SMTP_USER=your-scaleway-project-id
SMTP_PASS=your-iam-secret-key
MAIL_FROM=noreply@examensradar.de
MAIL_FROM_NAME=Examensradar
