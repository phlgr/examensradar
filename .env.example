# Admin password for /admin access
ADMIN_PASSWORD=your-admin-password

# Webhook secret for manually triggering /api/webhook/results (any random string)
WEBHOOK_SECRET=your-webhook-secret

# In-app JPA scraper check interval in ms (optional, defaults to 300000 = 5 minutes)
# SCRAPE_INTERVAL_MS=300000

# ntfy.sh configuration (optional, defaults to https://ntfy.sh)
NTFY_BASE_URL=https://ntfy.sh

# Database path (optional, defaults to ./data/examensradar.db)
DATABASE_PATH=./data/examensradar.db

# App URL for notification action buttons (optional, defaults to https://examensradar.de)
APP_URL=https://examensradar.de

# Mail sending via SMTP (Scaleway TEM in production)
# SMTP_USER is the Scaleway Project ID; SMTP_PASS is the secret key of an
# IAM API key that carries TransactionalEmail permissions.
# Port 465/2465 = implicit TLS, 587/2587 = STARTTLS.
SMTP_HOST=smtp.tem.scaleway.com
SMTP_PORT=465
SMTP_USER=your-scaleway-project-id
SMTP_PASS=your-iam-secret-key
MAIL_FROM=noreply@examensradar.de
MAIL_FROM_NAME=Examensradar
